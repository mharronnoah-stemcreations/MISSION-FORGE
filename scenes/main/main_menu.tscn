[node name="RichTextLabel" type="RichTextLabel" parent="Modals/ModalGuide/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#00e5ff][b]THE SIX PRIMARY RESOURCES OF SPACE MISSION DESIGN:[/b][/color]

[b]1. Mass (kg):[/b] Launch vehicles have strict payload fairing lift limits. Every gram counts; heavier spacecraft demand greater propellant and costlier rockets.

[b]2. Power (Watts):[/b] Electrical power must balance continuous consumption. In deep space or planetary night (lunar darkness or Mars dust storms), solar arrays lose efficiency and require RTGs or battery buffers.

[b]3. Budget ($ Millions):[/b] Every component adds development and launch costs. Efficient missions achieve maximum science without overspending.

[b]4. Scientific Data (MB/day):[/b] Advanced sensors (radars, multispectral imagers, spectrometers) generate high volumes of data that must be stored on onboard recorders.

[b]5. Communications (Mbps):[/b] Distance dictates signal strength! An omni antenna suffices for LEO, but reaching Earth from Mars requires a High-Gain parabolic dish pointed at NASA's Deep Space Network.

[b]6. Reliability (%):[/b] Space is harsh! Radiation-hardened computers and high-heritage hardware prevent in-flight anomalies.

[color=#ffb300][b]SCORING FORMULA:[/b][/color]
Score = 30% Science + 25% Reliability + 20% Resource Efficiency + 15% Budget + 10% Completion"

