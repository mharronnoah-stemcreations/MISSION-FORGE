class_name SpaceComponent
extends Resource

@export var id: String = ""
@export var display_name: String = ""
@export var category: String = "Structure" # "Structure", "Power", "Instruments", "Communications", "Propulsion", "Landing", "Data"

@export var mass: float = 0.0                # Total mass (kg)
@export var dry_mass: float = 0.0            # Dry mass without propellant (kg)
@export var propellant_mass: float = 0.0     # Usable propellant mass (kg)
@export var power_consumption: float = 0.0   # Watts
@export var power_generation: float = 0.0    # Watts continuous electrical generation
@export var cost: float = 0.0                # $ Millions

# Energy Storage (Batteries)
@export var battery_capacity_wh: float = 0.0 # Watt-hours of energy storage
@export var max_charge_w: float = 0.0        # Max charge rate (Watts)
@export var max_discharge_w: float = 0.0     # Max discharge rate (Watts)
@export var charge_efficiency: float = 0.92  # 0.0 to 1.0
@export var discharge_efficiency: float = 0.96 # 0.0 to 1.0

# Thermal & Nuclear
@export var thermal_output_w: float = 0.0    # Watts of thermal heat (e.g. MMRTG waste heat)

# Propulsion & Rocket Mechanics
@export var isp_seconds: float = 0.0         # Specific impulse (seconds)
@export var thrust_n: float = 0.0            # Engine thrust (Newtons)
@export var delta_v_impulse: float = 0.0     # Fallback legacy impulse (m/s)

# Data & Telemetry
@export var storage_capacity_gb: float = 0.0 # Solid-state recorder buffer capacity (GB)
@export var data_generation: float = 0.0     # MB/day generated by sensors
@export var comms_bandwidth: float = 0.0     # Mbps capacity
@export var science_value: float = 0.0       # Science points baseline

@export var reliability: float = 0.95        # Subsystem reliability (0.0 to 1.0)
@export var description: String = ""
@export var visual_type: String = "bus"      # Visual mesh identifier
@export var tech_notes: String = ""
@export var nasa_heritage: String = ""

static func from_dict(dict: Dictionary) -> SpaceComponent:
	var comp = SpaceComponent.new()
	comp.id = dict.get("id", "")
	comp.display_name = dict.get("display_name", "")
	comp.category = dict.get("category", "Structure")
	comp.mass = float(dict.get("mass", 0.0))
	comp.propellant_mass = float(dict.get("propellant_mass", 0.0))
	comp.dry_mass = float(dict.get("dry_mass", comp.mass - comp.propellant_mass))
	comp.power_consumption = float(dict.get("power_consumption", 0.0))
	comp.power_generation = float(dict.get("power_generation", 0.0))
	comp.cost = float(dict.get("cost", 0.0))
	
	# Battery storage
	comp.battery_capacity_wh = float(dict.get("battery_capacity_wh", 0.0))
	comp.max_charge_w = float(dict.get("max_charge_w", comp.battery_capacity_wh * 0.3))
	comp.max_discharge_w = float(dict.get("max_discharge_w", comp.battery_capacity_wh * 0.5))
	comp.charge_efficiency = float(dict.get("charge_efficiency", 0.92))
	comp.discharge_efficiency = float(dict.get("discharge_efficiency", 0.96))
	
	# Thermal & Nuclear
	comp.thermal_output_w = float(dict.get("thermal_output_w", 0.0))
	
	# Propulsion
	comp.isp_seconds = float(dict.get("isp_seconds", 0.0))
	comp.thrust_n = float(dict.get("thrust_n", 0.0))
	comp.delta_v_impulse = float(dict.get("delta_v_impulse", 0.0))
	
	# Data & Science
	comp.storage_capacity_gb = float(dict.get("storage_capacity_gb", 0.0))
	comp.data_generation = float(dict.get("data_generation", 0.0))
	comp.comms_bandwidth = float(dict.get("comms_bandwidth", 0.0))
	comp.science_value = float(dict.get("science_value", 0.0))
	comp.reliability = float(dict.get("reliability", 0.95))
	
	comp.description = dict.get("description", "")
	comp.visual_type = dict.get("visual_type", "bus")
	comp.tech_notes = dict.get("tech_notes", "")
	comp.nasa_heritage = dict.get("nasa_heritage", "")
	return comp
